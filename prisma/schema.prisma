generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                   Int                      @id @default(autoincrement())
  name                 String
  email                String                   @unique
  password             String
  role_id              Int?
  company_id           Int?
  active               Boolean                  @default(true)
  created_by_id        Int?
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt
  analysisPricings     analysis_pricing[]
  companies            companies[]
  companyAreas         company_areas[]
  companyContacts      company_contacts[]
  cylinderCheckouts    cylinder_checkout[]
  cylinders            cylinders[]
  invoiceHeaders       invoice_headers[]
  invoiceLines         invoice_lines[]
  importMachineReports import_machine_reports[]
  modules              modules[]
  roleModules          role_modules[]
  roles                roles[]
  sampleCheckins       sample_checkin[]
  company              companies?               @relation("CompanyUsers", fields: [company_id], references: [id])
  role                 roles?                   @relation("RoleUsers", fields: [role_id], references: [id])
  created_by           users?                   @relation("UserCreatedBy", fields: [created_by_id], references: [id], onDelete: Restrict)
  created_users        users[]                  @relation("UserCreatedBy")
  workorders_created   workorder_headers[]

  @@index([role_id])
  @@index([company_id])
  @@index([created_by_id])
}

model companies {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  name              String              @unique
  phone             String?
  email             String?
  billing_ref       String?
  billing_ref_no    String?
  billing_address   String?
  charge_h2_pop_fee    Boolean             @default(false)
  h2_pop_fee_rate      Decimal             @default(0) @db.Decimal(12, 2)
  pressure_base        Decimal?            @db.Decimal(10, 6)
  pressure_base_factor Decimal?            @db.Decimal(10, 6)
  active               Boolean             @default(true)
  created_by_id     Int?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  created_by        users?              @relation(fields: [created_by_id], references: [id], onDelete: Restrict)
  companyAreas      company_areas[]
  companyContacts   company_contacts[]
  cylinderCheckouts cylinder_checkout[]
  invoiceHeaders    invoice_headers[]
  sampleCheckins    sample_checkin[]
  users             users[]             @relation("CompanyUsers")
  workorder_headers workorder_headers[]
  importMachineReports import_machine_reports[]

  @@index([created_by_id])
}

model roles {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  description   String?
  active        Boolean        @default(true)
  created_by_id Int?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  role_modules  role_modules[]
  created_by    users?         @relation(fields: [created_by_id], references: [id], onDelete: Restrict)
  users         users[]        @relation("RoleUsers")

  @@index([created_by_id])
}

model modules {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  description   String?
  active        Boolean        @default(true)
  created_by_id Int
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  created_by    users          @relation(fields: [created_by_id], references: [id])
  role_modules  role_modules[]

  @@index([created_by_id])
}

model role_modules {
  id            Int      @id @default(autoincrement())
  role_id       Int
  module_id     Int
  active        Boolean  @default(true)
  created_by_id Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    users    @relation(fields: [created_by_id], references: [id])
  module        modules  @relation(fields: [module_id], references: [id], onDelete: Cascade)
  role          roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, module_id])
  @@index([module_id])
  @@index([created_by_id])
}

model company_areas {
  id             Int                @id @default(autoincrement())
  company_id     Int
  area           String
  region         String
  description    String?
  gl_code        String?
  pay_key        String?
  active         Boolean            @default(true)
  created_by_id  Int
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  company        companies          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  created_by     users              @relation(fields: [created_by_id], references: [id])
  contacts       company_contacts[]
  sampleCheckins sample_checkin[]

  @@unique([company_id, area])
  @@index([created_by_id])
}

model company_contacts {
  id                Int                 @id @default(autoincrement())
  company_id        Int
  company_area_id   Int?
  name              String
  phone             String?
  email             String?
  active            Boolean             @default(true)
  created_by_id     Int
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  company_area      company_areas?      @relation(fields: [company_area_id], references: [id])
  company           companies           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  created_by        users               @relation(fields: [created_by_id], references: [id])
  cylinderCheckouts cylinder_checkout[]
  sampleCheckins    sample_checkin[]

  @@unique([company_id, name])
  @@index([company_area_id])
  @@index([created_by_id])
}

model cylinders {
  id                Int                 @id @default(autoincrement())
  cylinder_number   String              @unique
  cylinder_type     String
  track_inventory   Boolean             @default(true)
  location          String
  active            Boolean             @default(true)
  created_by_id     Int
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  created_by        users               @relation(fields: [created_by_id], references: [id])
  cylinderCheckouts cylinder_checkout[]
  sampleCheckins    sample_checkin[]

  @@index([created_by_id])
}

model analysis_pricing {
  id             Int              @id @default(autoincrement())
  analysis_type  String           @unique
  description    String?
  standard_rate  Decimal          @db.Decimal(12, 2)
  rushed_rate    Decimal          @db.Decimal(12, 2)
  sample_fee     Decimal          @db.Decimal(12, 2)
  active         Boolean          @default(true)
  created_by_id  Int
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  created_by     users            @relation(fields: [created_by_id], references: [id])
  sampleCheckins sample_checkin[]

  @@index([created_by_id])
}

model cylinder_checkout {
  id                 Int              @id @default(autoincrement())
  cylinder_id        Int
  company_id         Int
  company_contact_id Int
  is_returned        Boolean          @default(false)
  returned_at        DateTime?
  created_by_id      Int
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  created_by         users            @relation(fields: [created_by_id], references: [id])
  cylinder           cylinders        @relation(fields: [cylinder_id], references: [id], onDelete: Restrict)
  company            companies        @relation(fields: [company_id], references: [id], onDelete: Restrict)
  company_contact    company_contacts @relation(fields: [company_contact_id], references: [id])

  @@index([cylinder_id])
  @@index([company_id])
  @@index([company_contact_id])
  @@index([created_by_id])
  @@index([is_returned])
}

model sample_checkin {
  id                       Int                     @id @default(autoincrement())
  company_id               Int
  company_contact_id       Int
  analysis_type_id         Int
  area_id                  Int?
  customer_cylinder        Boolean                 @default(false)
  rushed                   Boolean                 @default(false)
  sampled_by_lab           Boolean                 @default(false)
  cylinder_id              Int?
  cylinder_number          String?
  analysis_number          String                  @unique
  analysis_position        Int?
  producer                 String?
  well_name                String?
  meter_number             String?
  sample_type              String
  flow_rate                String?
  pressure                 String?
  pressure_unit            String?
  pressure_measured        String?
  temperature              String?
  amb_temp                 String?
  sample_time              String?
  sample_date              DateTime?
  sampled_by               String?
  analyzed_by              String?
  base_condition           String?
  physical_constant        String?
  field_h2s                Float                   @default(0)
  pressure_base_factor     Decimal                 @default(0) @db.Decimal(10, 6)
  cost_code                String?
  checkin_type             String
  invoice_ref_name         String?
  invoice_ref_value        String?
  remarks                  String?
  scanned_tag_image        String?
  work_order_number        String?
  status                   String
  standard_rate            Decimal                 @default(0) @db.Decimal(12, 2)
  applied_rate             Decimal                 @default(0) @db.Decimal(12, 2)
  sample_fee               Decimal                 @default(0) @db.Decimal(12, 2)
  h2_pop_fee               Decimal                 @default(0) @db.Decimal(12, 2)
  spot_composite_fee       Decimal                 @default(0) @db.Decimal(12, 2)
  import_machine_report_id Int?
  created_by_id            Int
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  invoiceLines             invoice_lines?
  analysis_pricing         analysis_pricing        @relation(fields: [analysis_type_id], references: [id])
  company_area             company_areas?          @relation(fields: [area_id], references: [id])
  company_contact          company_contacts        @relation(fields: [company_contact_id], references: [id])
  company                  companies               @relation(fields: [company_id], references: [id], onDelete: Restrict)
  created_by               users                   @relation(fields: [created_by_id], references: [id])
  cylinder                 cylinders?              @relation(fields: [cylinder_id], references: [id], onDelete: Restrict)
  import_machine_report    import_machine_reports? @relation(fields: [import_machine_report_id], references: [id], onDelete: SetNull)

  @@unique([work_order_number, analysis_position])
  @@index([company_id])
  @@index([company_contact_id])
  @@index([analysis_type_id])
  @@index([area_id])
  @@index([cylinder_id])
  @@index([import_machine_report_id])
  @@index([created_by_id])
  @@index([status])
}

model workorder_headers {
  id                    Int       @id @default(autoincrement())
  company_id            Int
  work_order_date       DateTime  @default(now())
  work_order_number     String    @unique
  cylinders             Int       @default(0)
  mileage_fee           Decimal   @db.Decimal(12, 2)
  miscellaneous_charges Decimal   @db.Decimal(12, 2)
  hourly_fee            Decimal   @db.Decimal(12, 2)
  miles                 Decimal   @db.Decimal(12, 2)
  rate_per_mile         Decimal   @db.Decimal(12, 2)
  status                String
  created_by_id         Int
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  company               companies @relation(fields: [company_id], references: [id], onDelete: Restrict)
  created_by            users     @relation(fields: [created_by_id], references: [id])

  @@index([company_id])
  @@index([created_by_id])
}

model invoice_headers {
  id                    Int             @id @default(autoincrement())
  company_id            Int
  invoice_number        String          @unique
  invoice_date          DateTime        @db.Date
  service_start_date    DateTime?       @db.Date
  service_end_date      DateTime?       @db.Date
  po_number             String?
  location              String?
  miles                 Decimal         @db.Decimal(12, 2)
  rate_per_mile         Decimal         @db.Decimal(12, 2)
  mileage_fee           Decimal         @db.Decimal(12, 2)
  miscellaneous_charges Decimal         @db.Decimal(12, 2)
  hourly_fee            Decimal         @db.Decimal(12, 2)
  subtotal              Decimal?        @db.Decimal(12, 2)
  tax_amount            Decimal?        @db.Decimal(12, 2)
  total_amount          Decimal?        @db.Decimal(12, 2)
  status                String          @default("draft")
  payment_status        String          @default("Pending")
  authorized_by         String?
  created_by_id         Int?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  company               companies       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  created_by            users?          @relation(fields: [created_by_id], references: [id], onDelete: Restrict)
  invoiceLines          invoice_lines[]

  @@index([company_id])
  @@index([created_by_id])
}

model invoice_lines {
  id                Int             @id @default(autoincrement())
  invoice_id        Int
  sample_checkin_id Int             @unique
  analysis_number   String          @unique
  description       String?
  service_date      DateTime?       @db.Date
  report_number     String?
  analysis_method   String?
  quantity          Decimal?        @db.Decimal(12, 2)
  unit_price        Decimal?        @db.Decimal(12, 2)
  amount            Decimal?        @db.Decimal(12, 2)
  created_by_id     Int?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  invoice           invoice_headers @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  sample_checkin    sample_checkin  @relation(fields: [sample_checkin_id], references: [id])
  created_by        users?          @relation(fields: [created_by_id], references: [id], onDelete: Restrict)

  @@index([invoice_id])
  @@index([created_by_id])
}

model import_machine_reports {
  id                    Int                       @id @default(autoincrement())
  import_id             String                    @unique
  source_machine        String
  status                String                    @default("Imported")
  file_name             String
  stored_file_name      String
  method_name           String?
  analyzed_by           String?
  base_condition        String?
  physical_constant     String?
  company_id            Int?
  pressure_base         Decimal                   @default(0) @db.Decimal(10, 6)
  pressure_base_factor  Decimal                   @default(0) @db.Decimal(10, 6)
  created_by_id         Int
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt
  created_by            users                     @relation(fields: [created_by_id], references: [id], onDelete: Restrict)
  company               companies?                @relation(fields: [company_id], references: [id], onDelete: SetNull)
  results               machine_report_results[]
  analysisResultMetrics analysis_result_metrics[]
  sampleCheckins        sample_checkin[]

  @@index([created_by_id])
  @@index([company_id])
  @@index([status])
}

model machine_report_results {
  id                       Int                    @id @default(autoincrement())
  import_machine_report_id Int
  analysis_position        Int
  sample_time              DateTime?
  sample_name              String?
  component                String
  component_description    String                 @db.VarChar(150)
  method_name              String?
  normalized_concentration Decimal?               @db.Decimal(18, 12)
  concentration            Decimal?               @db.Decimal(18, 12)
  normalized               Decimal?               @db.Decimal(18, 4)
  mol_pct                  Decimal?               @db.Decimal(18, 4)
  wt_pct                  Decimal?               @db.Decimal(18, 4)
  gpm                     Decimal?               @db.Decimal(18, 4)
  dry_gross_ideal         Decimal?               @db.Decimal(18, 4)
  wet_sample_ideal        Decimal?               @db.Decimal(18, 4)
  created_at              DateTime               @default(now())
  import_machine_report    import_machine_reports @relation(fields: [import_machine_report_id], references: [id], onDelete: Cascade)

  @@unique([import_machine_report_id, analysis_position, component])
  @@index([import_machine_report_id])
  @@index([analysis_position])
  @@index([component])
}

enum analysis_result_metric_type {
  gross_heating_value
  specific_gravity
  compressibility_factor
  gpm
}

model analysis_result_metrics {
  id                       Int                         @id @default(autoincrement())
  import_machine_report_id Int
  analysis_position        Int
  metric                   analysis_result_metric_type
  dry_ideal                Decimal?                    @db.Decimal(18, 6)
  dry_real                 Decimal?                    @db.Decimal(18, 6)
  wet_ideal                Decimal?                    @db.Decimal(18, 6)
  wet_real                 Decimal?                    @db.Decimal(18, 6)
  import_machine_report    import_machine_reports      @relation(fields: [import_machine_report_id], references: [id], onDelete: Cascade)

  @@unique([import_machine_report_id, analysis_position, metric])
  @@index([import_machine_report_id])
  @@index([analysis_position])
}

model gas_component_master {
  component_id        Int      @id @default(autoincrement())
  component_code      String   @unique @db.VarChar(10)
  component_name      String   @db.VarChar(100)
  chemical_formula    String?  @db.VarChar(50)
  calculation_formula String?
  comments            String?
  display_order       Int
  is_active           Boolean  @default(true)
  molecular_weight       Decimal? @db.Decimal(8, 4)
  gal_per_lb_mol         Decimal? @db.Decimal(10, 4)
  gross_heating_value    Decimal? @db.Decimal(10, 4)
  has_gpm                Boolean  @default(false)
  created_at          DateTime @default(now())

  @@index([display_order])
  @@index([is_active])
}

view open_checkout {
  id              Int?      @unique
  company_name    String?
  cylinder_type   String?
  cylinder_number String?
  contact_name    String?
  phone           String?
  email           String?
  checkout_date   DateTime?
}

view invoice_list {
  id             Int?      @unique
  invoice_date   DateTime? @db.Date
  company_name   String?
  invoice_number String?
  amount         Decimal?  @db.Decimal(12, 2)
  payment_status String?
}

view sample_analysis_position {
  sample_checkin_id        Int?    @unique
  company_name             String?
  work_order_number        String?
  cylinder_number          String?
  analysis_number          String?
  status                   String?
  analysis_position        Int?
  import_machine_report_id Int?
  import_id                String?
}
