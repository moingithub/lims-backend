### List companies
GET {{baseUrl}}/companies
Authorization: Bearer {{authToken}}

### Create company (pressure fields optional)
POST {{baseUrl}}/companies
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "COMP-005",
  "name": "Acme Corp5",
  "phone": null,
  "email": null,
  "billing_ref": null,
  "billing_ref_no": null,
  "billing_address": null,
  "charge_h2_pop_fee": true,
  "h2_pop_fee_rate": 50,
  "pressure_base": 14.73,
  "pressure_base_factor": 0.017500,
  "active": true
}

### Create company without pressure fields
POST {{baseUrl}}/companies
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "COMP-004",
  "name": "Acme Corp3",
  "active": true
}

### Get company by id
GET {{baseUrl}}/companies/2
Authorization: Bearer {{authToken}}

### Update company
PUT {{baseUrl}}/companies/2
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Acme Corporation",
  "phone": "+1-555-9876",
  "billing_address": "456 Commerce St, Metropolis",
  "charge_h2_pop_fee": true,
  "h2_pop_fee_rate": 25.00,
  "pressure_base": 14.696,
  "pressure_base_factor": 0.017500,
  "active": true
}

### Clear company pressure fields
PUT {{baseUrl}}/companies/2
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "pressure_base": null,
  "pressure_base_factor": null
}

### Delete company
DELETE {{baseUrl}}/companies/2
Authorization: Bearer {{authToken}}
