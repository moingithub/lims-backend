### List company areas
GET {{baseUrl}}/company_areas
Authorization: Bearer {{authToken}}

### Create company area
POST {{baseUrl}}/company_areas
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "company_id": 1,
  "area": "South-West",
  "description": "South region area",
  "gl_code": "GL-1001",
  "pay_key": "PAY-SW",
  "po": "PO-1001",
  "authorized_by": "Jane Smith",
  "cost_code": "CC-1001",
  "active": true
}

### Get company area by id
GET {{baseUrl}}/company_areas/2
Authorization: Bearer {{authToken}}

### Update company area
PUT {{baseUrl}}/company_areas/2
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "area": "North-East",
  "description": "Updated description",
  "gl_code": "GL-2002",
  "pay_key": "PAY-NE",
  "po": "PO-2002",
  "authorized_by": "John Doe",
  "cost_code": "CC-2002",
  "active": true
}

### Delete company area
DELETE {{baseUrl}}/company_areas/1
Authorization: Bearer {{authToken}}
